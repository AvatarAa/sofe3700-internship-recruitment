PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=internship_recruitment
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters_long
NODE_ENV=development

# Optional: create the first ADMIN user automatically when the server starts.
# Use an email not already present in app_user. Keep this password private.
BOOTSTRAP_ADMIN_EMAIL=admin@phase3.local
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_private_password_at_least_10_characters
